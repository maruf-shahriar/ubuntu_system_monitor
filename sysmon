#!/usr/bin/env python3
"""sysmon - terminal system overview for Ubuntu, with scheduled Telegram reports.

Usage:
  sysmon                 show the overview once
  sysmon watch [-n 2]    live view, refreshes every N seconds (Ctrl+C to quit)
  sysmon setup           connect a Telegram bot and turn on scheduled reports
  sysmon send            send a report to Telegram right now
  sysmon interval 30m    change how often reports are sent (e.g. 15m, 1h, 2h30m)
  sysmon schedule on|off|status
  sysmon config          show where settings live and what they are
"""

